37648>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37651>>>        Case Begin
37651>>>            Case (NavigateData.eNavigateType = nfFromMain)
37653>>>                Case Break
37654>>>
37654>>>            Case (NavigateData.eNavigateType = nfFromParent)
37657>>>                Case Break
37658>>>
37658>>>            Case (NavigateData.eNavigateType = nfFromChild)
37661>>>                Case Break
37662>>>
37662>>>            Case Else
37662>>>        Case End
37662>>>
37662>>>        Send SetActionButtons
37663>>>
37663>>>    End_Procedure
