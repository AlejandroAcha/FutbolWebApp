37603>>>    Procedure SetActionButtons
37606>>>        tWebNavigateData NavigateData
37606>>>        tWebNavigateData NavigateData
37606>>>        Boolean bHasRecord
37606>>>        Handle hoDD
37606>>>
37606>>>        Get Server to hoDD
37607>>>        Get GetNavigateData to NavigateData
37608>>>        Get HasRecord of hoDD to bHasRecord
37609>>>
37609>>>        // let's hide all buttons and then Show the ones we want
37609>>>        WebSet pbRender of oEditBtn to False
37610>>>        WebSet pbRender of oSaveBtn to False
37611>>>        WebSet pbRender of oCancelChangesBtn to False
37612>>>        WebSet pbRender of oDeleteBtn to False
37613>>>
37613>>>        If (NavigateData.bReadOnly) Begin
37615>>>            WebSet pbRender of oEditBtn to True
37616>>>        End
37616>>>>
37616>>>        Else Begin
37617>>>            WebSet pbRender of oSaveBtn to True
37618>>>            WebSet pbRender of oCancelChangesBtn to True
37619>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37620>>>        End
37620>>>>
37620>>>    End_Procedure
