37910>>>    Procedure SetActionButtons
37913>>>        tWebNavigateData NavigateData
37913>>>        tWebNavigateData NavigateData
37913>>>        Boolean bHasRecord
37913>>>        Handle hoDD
37913>>>
37913>>>        Get Server to hoDD
37914>>>        Get GetNavigateData to NavigateData
37915>>>        Get HasRecord of hoDD to bHasRecord
37916>>>
37916>>>        // let's hide all buttons and then Show the ones we want
37916>>>        WebSet pbRender of oEditBtn to False
37917>>>        WebSet pbRender of oSaveBtn to False
37918>>>        WebSet pbRender of oCancelChangesBtn to False
37919>>>        WebSet pbRender of oDeleteBtn to False
37920>>>
37920>>>        If (NavigateData.bReadOnly) Begin
37922>>>            WebSet pbRender of oEditBtn to True
37923>>>        End
37923>>>>
37923>>>        Else Begin
37924>>>            WebSet pbRender of oSaveBtn to True
37925>>>            WebSet pbRender of oCancelChangesBtn to True
37926>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37927>>>        End
37927>>>>
37927>>>    End_Procedure
