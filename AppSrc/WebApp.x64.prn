37927>>>    Procedure SetActionButtons
37930>>>        tWebNavigateData NavigateData
37930>>>        tWebNavigateData NavigateData
37930>>>        Boolean bHasRecord
37930>>>        Handle hoDD
37930>>>
37930>>>        Get Server to hoDD
37931>>>        Get GetNavigateData to NavigateData
37932>>>        Get HasRecord of hoDD to bHasRecord
37933>>>
37933>>>        // let's hide all buttons and then Show the ones we want
37933>>>        WebSet pbRender of oEditBtn to False
37934>>>        WebSet pbRender of oSaveBtn to False
37935>>>        WebSet pbRender of oCancelChangesBtn to False
37936>>>        WebSet pbRender of oDeleteBtn to False
37937>>>
37937>>>        If (NavigateData.bReadOnly) Begin
37939>>>            WebSet pbRender of oEditBtn to True
37940>>>        End
37940>>>>
37940>>>        Else Begin
37941>>>            WebSet pbRender of oSaveBtn to True
37942>>>            WebSet pbRender of oCancelChangesBtn to True
37943>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37944>>>        End
37944>>>>
37944>>>    End_Procedure
