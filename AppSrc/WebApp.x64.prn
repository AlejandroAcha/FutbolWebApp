38999>>>        Case Begin
38999>>>            Case (NavigateData.eNavigateType = nfFromMain)
39001>>>                // If from main, this is a propbably a main file Select to Zoom.
39001>>>                Case Break
39002>>>
39002>>>            Case (NavigateData.eNavigateType = nfFromParent)
39005>>>                // If from parent, this is a constrained drill down.
39005>>>                Case Break
39006>>>
39006>>>            Case (NavigateData.eNavigateType = nfFromChild)
39009>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39009>>>                Case Break
39010>>>
39010>>>            Case Else // must be nfUndefined
39010>>>
39010>>>        Case End
39010>>>
39010>>>        Send SetActionButtons
39011>>>
