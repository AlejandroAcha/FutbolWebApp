38473>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38476>>>        WebSet pbRender of oNewButton to True
38477>>>        WebSet pbRender of oDetailButton to True
38478>>>
38478>>>        Case Begin
38478>>>            Case (NavigateData.eNavigateType = nfFromParent)
38480>>>                // If from parent, this is a constrained drill down
38480>>>                // If Row select does main-zoom we don't need this
38480>>>                WebSet pbRender of oDetailButton to False
38481>>>                Case Break
38482>>>
38482>>>            Case (NavigateData.eNavigateType = nfFromChild)
38485>>>                // If from child, this is a probably a parent lookup from a Zoom
38485>>>                Case Break
38486>>>
38486>>>            Case (NavigateData.eNavigateType = nfFromMain)
38489>>>                // If from main, this is a probably a main-file lookup from a Zoom
38489>>>                WebSet pbRender of oDetailButton to False
38490>>>                Case Break
38491>>>
38491>>>            Case Else // must be nfUndefined
38491>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38491>>>                // If Row select does main-zoom we don't need this
38491>>>                WebSet pbRender of oDetailButton to False
38492>>>
38492>>>        Case End
38492>>>
38492>>>    End_Procedure
38493>>>
38493>>>
38493>>>End_Object 
