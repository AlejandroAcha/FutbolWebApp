37951>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37951>>>                Case Break
37952>>>
37952>>>            Case Else // must be nfUndefined
37952>>>
37952>>>        Case End
37952>>>
37952>>>        Send SetActionButtons
