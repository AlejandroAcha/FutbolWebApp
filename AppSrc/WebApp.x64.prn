37968>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37968>>>                Case Break
37969>>>
37969>>>            Case Else // must be nfUndefined
37969>>>
37969>>>        Case End
37969>>>
37969>>>        Send SetActionButtons
37970>>>
