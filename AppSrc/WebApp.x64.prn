39175>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39178>>>        WebSet pbRender of oNewButton to True
39179>>>        WebSet pbRender of oDetailButton to True
39180>>>
39180>>>        Case Begin
39180>>>            Case (NavigateData.eNavigateType = nfFromParent)
39182>>>                // If from parent, this is a constrained drill down
39182>>>                // If Row select does main-zoom we don't need this
39182>>>                WebSet pbRender of oDetailButton to False
39183>>>                Case Break
39184>>>
39184>>>            Case (NavigateData.eNavigateType = nfFromChild)
39187>>>                // If from child, this is a probably a parent lookup from a Zoom
39187>>>                Case Break
39188>>>
39188>>>            Case (NavigateData.eNavigateType = nfFromMain)
39191>>>                // If from main, this is a probably a main-file lookup from a Zoom
39191>>>                WebSet pbRender of oDetailButton to False
39192>>>                Case Break
39193>>>
39193>>>            Case Else // must be nfUndefined
39193>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39193>>>                // If Row select does main-zoom we don't need this
39193>>>                WebSet pbRender of oDetailButton to False
39194>>>
39194>>>        Case End
39194>>>
39194>>>    End_Procedure
