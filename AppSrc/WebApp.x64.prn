37631>>>
37631>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37634>>>        Case Begin
37634>>>            Case (NavigateData.eNavigateType = nfFromMain)
37636>>>                // If from main, this is a propbably a main file Select to Zoom.
37636>>>                Case Break
37637>>>
37637>>>            Case (NavigateData.eNavigateType = nfFromParent)
37640>>>                // If from parent, this is a constrained drill down.
37640>>>                Case Break
37641>>>
37641>>>            Case (NavigateData.eNavigateType = nfFromChild)
37644>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37644>>>                Case Break
37645>>>
37645>>>            Case Else // must be nfUndefined
37645>>>
37645>>>        Case End
37645>>>
37645>>>        Send SetActionButtons
37646>>>
37646>>>    End_Procedure
37647>>>
37647>>>End_Object 
