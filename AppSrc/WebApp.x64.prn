38184>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38187>>>        WebSet pbRender of oNewButton to True
38188>>>        WebSet pbRender of oDetailButton to True
38189>>>
38189>>>        Case Begin
38189>>>            Case (NavigateData.eNavigateType = nfFromParent)
38191>>>                // If from parent, this is a constrained drill down
38191>>>                // If Row select does main-zoom we don't need this
38191>>>                WebSet pbRender of oDetailButton to False
38192>>>                Case Break
38193>>>
38193>>>            Case (NavigateData.eNavigateType = nfFromChild)
38196>>>                // If from child, this is a probably a parent lookup from a Zoom
38196>>>                Case Break
38197>>>
38197>>>            Case (NavigateData.eNavigateType = nfFromMain)
38200>>>                // If from main, this is a probably a main-file lookup from a Zoom
38200>>>                WebSet pbRender of oDetailButton to False
38201>>>                Case Break
38202>>>
38202>>>            Case Else // must be nfUndefined
38202>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38202>>>                // If Row select does main-zoom we don't need this
38202>>>                WebSet pbRender of oDetailButton to False
38203>>>
38203>>>        Case End
38203>>>
38203>>>    End_Procedure
