38968>>>    Procedure SetActionButtons
38971>>>        tWebNavigateData NavigateData
38971>>>        tWebNavigateData NavigateData
38971>>>        Boolean bHasRecord
38971>>>        Handle hoDD
38971>>>
38971>>>        Get Server to hoDD
38972>>>        Get GetNavigateData to NavigateData
38973>>>        Get HasRecord of hoDD to bHasRecord
38974>>>
38974>>>        // let's hide all buttons and then Show the ones we want
38974>>>        WebSet pbRender of oEditBtn to False
38975>>>        WebSet pbRender of oSaveBtn to False
38976>>>        WebSet pbRender of oCancelChangesBtn to False
38977>>>        WebSet pbRender of oDeleteBtn to False
38978>>>
38978>>>        If (NavigateData.bReadOnly) Begin
38980>>>            WebSet pbRender of oEditBtn to True
38981>>>        End
38981>>>>
38981>>>        Else Begin
38982>>>            WebSet pbRender of oSaveBtn to True
38983>>>            WebSet pbRender of oCancelChangesBtn to True
38984>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38985>>>        End
38985>>>>
38985>>>    End_Procedure
