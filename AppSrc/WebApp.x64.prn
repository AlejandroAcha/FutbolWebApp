38303>>>    Procedure SetActionButtons
38306>>>        tWebNavigateData NavigateData
38306>>>        tWebNavigateData NavigateData
38306>>>        Boolean bHasRecord
38306>>>        Handle hoDD
38306>>>
38306>>>        Get Server to hoDD
38307>>>        Get GetNavigateData to NavigateData
38308>>>        Get HasRecord of hoDD to bHasRecord
38309>>>
38309>>>        // let's hide all buttons and then Show the ones we want
38309>>>        WebSet pbRender of oEditBtn to False
38310>>>        WebSet pbRender of oSaveBtn to False
38311>>>        WebSet pbRender of oCancelChangesBtn to False
38312>>>        WebSet pbRender of oDeleteBtn to False
38313>>>
38313>>>        If (NavigateData.bReadOnly) Begin
38315>>>            WebSet pbRender of oEditBtn to True
38316>>>        End
38316>>>>
38316>>>        Else Begin
38317>>>            WebSet pbRender of oSaveBtn to True
38318>>>            WebSet pbRender of oCancelChangesBtn to True
38319>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38320>>>        End
38320>>>>
38320>>>    End_Procedure
38321>>>
38321>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38324>>>        // Close after save
38324>>>        Send NavigateClose Self
38325>>>    End_Procedure
38326>>>
38326>>>    // this will close the view after a delete
38326>>>    Procedure OnViewDeleted Handle hoDDO
38329>>>        Send NavigateClose Self
38330>>>    End_Procedure
38331>>>
38331>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38334>>>        Case Begin
38334>>>            Case (NavigateData.eNavigateType = nfFromMain)
38336>>>                // If from main, this is a propbably a main file Select to Zoom.
38336>>>                Case Break
38337>>>
38337>>>            Case (NavigateData.eNavigateType = nfFromParent)
38340>>>                // If from parent, this is a constrained drill down.
38340>>>                Case Break
38341>>>
38341>>>            Case (NavigateData.eNavigateType = nfFromChild)
38344>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38344>>>                Case Break
38345>>>
38345>>>            Case Else // must be nfUndefined
38345>>>
38345>>>        Case End
38345>>>
38345>>>        Send SetActionButtons
38346>>>
38346>>>    End_Procedure
38347>>>
38347>>>End_Object 
